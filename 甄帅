-- 每小时统计总使用次数
local function reportTotalUsage()
    local embed = {
        title = "脚本使用统计（每小时）",
        description = string.format("脚本：%s\n累计使用次数：**%d**", SCRIPT_NAME, totalUsageCount),
        color = 3447003,
        timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ")
    }
    local data = {
        username = "使用统计",
        embeds = {embed},
        content = ""
    }
    local jsonData = HttpService:JSONEncode(data)
    pcall(function()
        HttpService:RequestAsync({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json",
                ["User-Agent"] = "Roblox/WinInet"
            },
            Body = jsonData
        })
    end)
end

